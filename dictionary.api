import React, { useState, useEffect } from 'react';
import { Search, BookOpen, Star, Clock, Volume2, Moon, Sun, Lightbulb, Image } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Separator } from '@/components/ui/separator';
import { useToast } from '@/hooks/use-toast';

interface WordDefinition {
  word: string;
  phonetic?: string;
  phonetics: Array<{
    text?: string;
    audio?: string;
  }>;
  meanings: Array<{
    partOfSpeech: string;
    definitions: Array<{
      definition: string;
      example?: string;
      synonyms?: string[];
      antonyms?: string[];
    }>;
    synonyms?: string[];
    antonyms?: string[];
  }>;
  origin?: string;
}

interface WordImage {
  id: string;
  urls: {
    small: string;
    regular: string;
  };
  alt_description: string;
  user: {
    name: string;
  };
}

const Index = () => {
  const [searchTerm, setSearchTerm] = useState('');
  const [wordData, setWordData] = useState<WordDefinition | null>(null);
  const [wordImages, setWordImages] = useState<WordImage[]>([]);
  const [loading, setLoading] = useState(false);
  const [loadingImages, setLoadingImages] = useState(false);
  const [error, setError] = useState('');
  const [recentSearches, setRecentSearches] = useState<string[]>([]);
  const [favorites, setFavorites] = useState<string[]>([]);
  const [darkMode, setDarkMode] = useState(false);
  const [wordOfTheDay, setWordOfTheDay] = useState<WordDefinition | null>(null);
  const [wordOfTheDayImages, setWordOfTheDayImages] = useState<WordImage[]>([]);
  const { toast } = useToast();

  useEffect(() => {
    // Load saved data from localStorage
    const savedRecentSearches = localStorage.getItem('recentSearches');
    const savedFavorites = localStorage.getItem('favorites');
    const savedDarkMode = localStorage.getItem('darkMode');
    
    if (savedRecentSearches) {
      setRecentSearches(JSON.parse(savedRecentSearches));
    }
    if (savedFavorites) {
      setFavorites(JSON.parse(savedFavorites));
    }
    if (savedDarkMode) {
      setDarkMode(JSON.parse(savedDarkMode));
    }

    // Load word of the day
    fetchWordOfTheDay();
  }, []);

  useEffect(() => {
    // Apply dark mode
    if (darkMode) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  }, [darkMode]);

  const fetchWordImages = async (word: string) => {
    setLoadingImages(true);
    try {
      const response = await fetch(`https://api.unsplash.com/search/photos?query=${encodeURIComponent(word)}&per_page=3&client_id=YOUR_UNSPLASH_ACCESS_KEY`);
      
      if (response.ok) {
        const data = await response.json();
        setWordImages(data.results || []);
      } else {
        // Fallback: use a demo image or empty array
        setWordImages([]);
      }
    } catch (error) {
      console.error('Failed to fetch images:', error);
      setWordImages([]);
    } finally {
      setLoadingImages(false);
    }
  };

  const fetchWordOfTheDayImages = async (word: string) => {
    try {
      const response = await fetch(`https://api.unsplash.com/search/photos?query=${encodeURIComponent(word)}&per_page=1&client_id=YOUR_UNSPLASH_ACCESS_KEY`);
      
      if (response.ok) {
        const data = await response.json();
        setWordOfTheDayImages(data.results || []);
      }
    } catch (error) {
      console.error('Failed to fetch word of the day images:', error);
      setWordOfTheDayImages([]);
    }
  };

  const fetchWordOfTheDay = async () => {
    try {
      const words = ['serendipity', 'ephemeral', 'quintessential', 'ubiquitous', 'eloquent'];
      const randomWord = words[Math.floor(Math.random() * words.length)];
      const response = await fetch(`https://api.dictionaryapi.dev/api/v2/entries/en/${randomWord}`);
      if (response.ok) {
        const data = await response.json();
        setWordOfTheDay(data[0]);
        fetchWordOfTheDayImages(randomWord);
      }
    } catch (error) {
      console.error('Failed to fetch word of the day:', error);
    }
  };

  const searchWord = async (word: string) => {
    if (!word.trim()) return;

    setLoading(true);
    setError('');
    setWordData(null);
    setWordImages([]);

    try {
      const response = await fetch(`https://api.dictionaryapi.dev/api/v2/entries/en/${word.toLowerCase()}`);
      
      if (!response.ok) {
        throw new Error('Word not found');
      }

      const data = await response.json();
      setWordData(data[0]);
      
      // Fetch images for the word
      fetchWordImages(word);
      
      // Add to recent searches
      const newRecentSearches = [word, ...recentSearches.filter(w => w !== word)].slice(0, 10);
      setRecentSearches(newRecentSearches);
      localStorage.setItem('recentSearches', JSON.stringify(newRecentSearches));
      
      toast({
        title: "Word found!",
        description: `Successfully loaded definition for "${word}".`,
      });
    } catch (error) {
      setError(`Sorry, we couldn't find the word "${word}". Please check your spelling and try again.`);
      toast({
        title: "Word not found",
        description: `No definition found for "${word}".`,
        variant: "destructive",
      });
    } finally {
      setLoading(false);
    }
  };

  const handleSearch = (e: React.FormEvent) => {
    e.preventDefault();
    searchWord(searchTerm);
  };

  const playAudio = (audioUrl: string) => {
    const audio = new Audio(audioUrl);
    audio.play().catch(() => {
      toast({
        title: "Audio unavailable",
        description: "Unable to play pronunciation audio.",
        variant: "destructive",
      });
    });
  };

  const toggleFavorite = (word: string) => {
    const newFavorites = favorites.includes(word)
      ? favorites.filter(w => w !== word)
      : [...favorites, word];
    
    setFavorites(newFavorites);
    localStorage.setItem('favorites', JSON.stringify(newFavorites));
    
    toast({
      title: favorites.includes(word) ? "Removed from favorites" : "Added to favorites",
      description: `"${word}" ${favorites.includes(word) ? 'removed from' : 'added to'} your favorites.`,
    });
  };

  const toggleDarkMode = () => {
    const newDarkMode = !darkMode;
    setDarkMode(newDarkMode);
    localStorage.setItem('darkMode', JSON.stringify(newDarkMode));
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-blue-50 via-white to-purple-50 dark:from-gray-900 dark:via-gray-800 dark:to-purple-900 transition-all duration-500">
      <div className="container mx-auto px-4 py-8 max-w-4xl">
        {/* Header */}
        <div className="flex items-center justify-between mb-8">
          <div className="flex items-center space-x-3">
            <div className="p-3 bg-gradient-to-r from-blue-500 to-purple-600 rounded-xl shadow-lg">
              <BookOpen className="h-8 w-8 text-white" />
            </div>
            <div>
              <h1 className="text-3xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
                Dictionary
              </h1>
              <p className="text-sm text-gray-600 dark:text-gray-300">Explore the English language with visual context</p>
            </div>
          </div>
          <Button
            variant="outline"
            size="icon"
            onClick={toggleDarkMode}
            className="rounded-full border-2"
          >
            {darkMode ? <Sun className="h-4 w-4" /> : <Moon className="h-4 w-4" />}
          </Button>
        </div>

        {/* Search Form */}
        <Card className="mb-8 shadow-xl border-0 bg-white/70 dark:bg-gray-800/70 backdrop-blur-sm">
          <CardContent className="p-6">
            <form onSubmit={handleSearch} className="flex space-x-4">
              <div className="flex-1 relative">
                <Search className="absolute left-3 top-3 h-5 w-5 text-gray-400" />
                <Input
                  type="text"
                  placeholder="Search for any English word..."
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                  className="pl-10 h-12 text-lg border-2 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                />
              </div>
              <Button
                type="submit"
                disabled={loading}
                className="h-12 px-8 bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 rounded-xl"
              >
                {loading ? (
                  <div className="animate-spin rounded-full h-5 w-5 border-b-2 border-white"></div>
                ) : (
                  'Search'
                )}
              </Button>
            </form>
          </CardContent>
        </Card>

        {/* Error Message */}
        {error && (
          <Card className="mb-8 border-red-200 bg-red-50 dark:bg-red-900/20 dark:border-red-800">
            <CardContent className="p-4">
              <p className="text-red-700 dark:text-red-300">{error}</p>
            </CardContent>
          </Card>
        )}

        {/* Word Result */}
        {wordData && (
          <Card className="mb-8 shadow-xl border-0 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm">
            <CardHeader className="pb-4">
              <div className="flex items-center justify-between">
                <div className="flex items-center space-x-4">
                  <CardTitle className="text-3xl font-bold text-gray-800 dark:text-white">
                    {wordData.word}
                  </CardTitle>
                  <Button
                    variant="ghost"
                    size="icon"
                    onClick={() => toggleFavorite(wordData.word)}
                    className="rounded-full hover:bg-yellow-100 dark:hover:bg-yellow-900/30"
                  >
                    <Star className={`h-5 w-5 ${favorites.includes(wordData.word) ? 'fill-yellow-500 text-yellow-500' : 'text-gray-400'}`} />
                  </Button>
                </div>
                {wordData.phonetic && (
                  <div className="flex items-center space-x-2">
                    <span className="text-lg text-gray-600 dark:text-gray-300 font-mono">
                      {wordData.phonetic}
                    </span>
                    {wordData.phonetics?.find(p => p.audio) && (
                      <Button
                        variant="ghost"
                        size="icon"
                        onClick={() => {
                          const audioUrl = wordData.phonetics.find(p => p.audio)?.audio;
                          if (audioUrl) playAudio(audioUrl);
                        }}
                        className="rounded-full hover:bg-blue-100 dark:hover:bg-blue-900/30"
                      >
                        <Volume2 className="h-4 w-4 text-blue-600" />
                      </Button>
                    )}
                  </div>
                )}
              </div>
            </CardHeader>
            <CardContent className="space-y-6">
              {/* Word Images */}
              {wordImages.length > 0 && (
                <div className="space-y-3">
                  <div className="flex items-center space-x-2">
                    <Image className="h-5 w-5 text-blue-600" />
                    <h4 className="font-medium text-gray-800 dark:text-gray-200">Visual Context</h4>
                  </div>
                  <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                    {wordImages.map((image) => (
                      <div key={image.id} className="relative group">
                        <img
                          src={image.urls.small}
                          alt={image.alt_description || wordData.word}
                          className="w-full h-32 object-cover rounded-lg shadow-md group-hover:shadow-lg transition-shadow"
                        />
                        <div className="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent rounded-b-lg p-2">
                          <p className="text-white text-xs truncate">Photo by {image.user.name}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {loadingImages && (
                <div className="flex items-center justify-center py-4">
                  <div className="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600"></div>
                  <span className="ml-2 text-gray-600 dark:text-gray-300">Loading images...</span>
                </div>
              )}

              {/* Definitions */}
              {wordData.meanings.map((meaning, meaningIndex) => (
                <div key={meaningIndex} className="space-y-4">
                  <Badge variant="outline" className="text-sm px-3 py-1 bg-gradient-to-r from-blue-500 to-purple-600 text-white border-0">
                    {meaning.partOfSpeech}
                  </Badge>
                  
                  <div className="space-y-3">
                    {meaning.definitions.map((def, defIndex) => (
                      <div key={defIndex} className="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4">
                        <p className="text-gray-800 dark:text-gray-200 mb-2">
                          <span className="font-medium">{defIndex + 1}.</span> {def.definition}
                        </p>
                        {def.example && (
                          <p className="text-gray-600 dark:text-gray-400 italic pl-4 border-l-2 border-blue-300">
                            "{def.example}"
                          </p>
                        )}
                        {(def.synonyms || def.antonyms) && (
                          <div className="mt-3 space-y-2">
                            {def.synonyms && def.synonyms.length > 0 && (
                              <div>
                                <span className="text-sm font-medium text-green-600 dark:text-green-400">Synonyms: </span>
                                <span className="text-sm text-gray-600 dark:text-gray-300">
                                  {def.synonyms.slice(0, 5).join(', ')}
                                </span>
                              </div>
                            )}
                            {def.antonyms && def.antonyms.length > 0 && (
                              <div>
                                <span className="text-sm font-medium text-red-600 dark:text-red-400">Antonyms: </span>
                                <span className="text-sm text-gray-600 dark:text-gray-300">
                                  {def.antonyms.slice(0, 5).join(', ')}
                                </span>
                              </div>
                            )}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                  
                  {meaningIndex < wordData.meanings.length - 1 && <Separator />}
                </div>
              ))}
              
              {wordData.origin && (
                <div className="bg-gradient-to-r from-purple-50 to-blue-50 dark:from-purple-900/20 dark:to-blue-900/20 rounded-lg p-4">
                  <h4 className="font-medium text-gray-800 dark:text-gray-200 mb-2">Etymology</h4>
                  <p className="text-gray-600 dark:text-gray-300 text-sm">{wordData.origin}</p>
                </div>
              )}
            </CardContent>
          </Card>
        )}

        {/* Bottom Section */}
        <div className="grid md:grid-cols-2 gap-8">
          {/* Word of the Day */}
          {wordOfTheDay && (
            <Card className="shadow-lg border-0 bg-gradient-to-br from-yellow-50 to-orange-50 dark:from-yellow-900/20 dark:to-orange-900/20 backdrop-blur-sm">
              <CardHeader>
                <div className="flex items-center space-x-2">
                  <Lightbulb className="h-5 w-5 text-yellow-600" />
                  <CardTitle className="text-lg">Word of the Day</CardTitle>
                </div>
              </CardHeader>
              <CardContent>
                <div className="space-y-3">
                  {wordOfTheDayImages.length > 0 && (
                    <img
                      src={wordOfTheDayImages[0].urls.small}
                      alt={wordOfTheDayImages[0].alt_description || wordOfTheDay.word}
                      className="w-full h-24 object-cover rounded-lg shadow-sm"
                    />
                  )}
                  <h3 
                    className="text-xl font-bold text-blue-600 cursor-pointer hover:text-blue-800 transition-colors"
                    onClick={() => {setSearchTerm(wordOfTheDay.word); searchWord(wordOfTheDay.word);}}
                  >
                    {wordOfTheDay.word}
                  </h3>
                  {wordOfTheDay.phonetic && (
                    <p className="text-sm text-gray-600 dark:text-gray-300 font-mono">{wordOfTheDay.phonetic}</p>
                  )}
                  <p className="text-sm text-gray-700 dark:text-gray-300">
                    {wordOfTheDay.meanings[0]?.definitions[0]?.definition}
                  </p>
                </div>
              </CardContent>
            </Card>
          )}

          {/* Recent Searches & Favorites */}
          <Card className="shadow-lg border-0 bg-white/70 dark:bg-gray-800/70 backdrop-blur-sm">
            <CardHeader>
              <div className="flex items-center space-x-2">
                <Clock className="h-5 w-5 text-gray-600" />
                <CardTitle className="text-lg">Recent & Favorites</CardTitle>
              </div>
            </CardHeader>
            <CardContent className="space-y-4">
              {favorites.length > 0 && (
                <div>
                  <h4 className="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 flex items-center">
                    <Star className="h-4 w-4 mr-1 text-yellow-500" />
                    Favorites
                  </h4>
                  <div className="flex flex-wrap gap-2">
                    {favorites.slice(0, 5).map((word, index) => (
                      <Badge
                        key={index}
                        variant="secondary"
                        className="cursor-pointer hover:bg-yellow-100 dark:hover:bg-yellow-900/30 transition-colors"
                        onClick={() => {setSearchTerm(word); searchWord(word);}}
                      >
                        {word}
                      </Badge>
                    ))}
                  </div>
                </div>
              )}
              
              {recentSearches.length > 0 && (
                <div>
                  <h4 className="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Recent</h4>
                  <div className="flex flex-wrap gap-2">
                    {recentSearches.slice(0, 8).map((word, index) => (
                      <Badge
                        key={index}
                        variant="outline"
                        className="cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                        onClick={() => {setSearchTerm(word); searchWord(word);}}
                      >
                        {word}
                      </Badge>
                    ))}
                  </div>
                </div>
              )}
              
              {recentSearches.length === 0 && favorites.length === 0 && (
                <p className="text-gray-500 dark:text-gray-400 text-sm text-center py-4">
                  Start searching to see your recent words and favorites here!
                </p>
              )}
            </CardContent>
          </Card>
        </div>
      </div>
    </div>
  );
};

export default Index;
